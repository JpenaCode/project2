<!-- views/user/edit.ejs -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Movies App</title>
  </head>
  <body>
    
    <a href="/movies/">Back to Movies</a>


    <h1>Edit <%= movie.title %></h1>

    <form action="/movies/<%=movie._id%>?_method=PUT" method="POST">
        <label for="title">Movie Title:</label>
        <input type="text" name="title" id="title" />
        <br/>
        <br/>
        <label for="director">Director Name:</label>
        <input type="text" name="directorName" id="director" />
        <br/>
        <br/>
        <label for="year">Release Year:</label>
        <input type="text" name="year" id="year" />
        <br/>
        <br/>
        <label for="genre">Genre:</label>
        <input type="text" name="genre" id="genre" />
        <br/>
        <br/>
        <label for="rating">Age Rating:</label>
        <input type="text" name="rating" id="rating" />
        <br/>
        <br/>
        <label for="addToFavorites">Add It To Your Favorites List?</label>
        <input type="checkbox" name="addToFavorites" id="addToFavorites" />

      <button type="submit">Update Movie</button>
    </form>
  </body>
</html>
