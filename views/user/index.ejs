<!-- views/user/index.ejs -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Movie Index</title>
  </head>
  <!-- views/user/index.ejs -->
  <a href="/movies/new">Add A New Movie</a>

<body>
  <h1>All Movies</h1>
  <ul>
    <% movies.forEach(movie => { %>
      <li><a href="/movies/<%= movie.id %>"><%= movie.title %></a></li>
    <% }); %>
  </ul>
</body>


</html>
